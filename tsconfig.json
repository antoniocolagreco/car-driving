{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "paths": {
            "@app": ["./src/app.ts"],
            "@core/*": ["./src/core/*"],
            "@render/*": ["./src/render/*"],
            "@ui/*": ["./src/ui/*"],
            "@components/*": ["./src/components/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@css/*": ["./src/css/*"]
        }
    }
}
