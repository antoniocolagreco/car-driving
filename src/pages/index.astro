---
import {
    ChevronsUpIcon,
    EyeIcon,
    FastForwardIcon,
    RedoIcon,
    TableIcon,
    TrashIcon,
} from '@lucide/astro'
import type { HTMLAttributes } from 'astro/types'
import { BRAKE_BONUSES, CARS_QUANTITY, COURSE_INTERVALS, DEFAULTS, MUTATION } from '@core/config'
import { ELEMENT_IDS } from '@ui/dom'
import Button from '@components/button.astro'
import Field from '@components/field.astro'
import InfoPanel from '@components/info-panel.astro'
import InfoText from '@components/info-text.astro'
import Input from '@components/input.astro'
import NumberInput from '@components/number-input.astro'
import Range from '@components/range.astro'
import ChampionPanel from '@components/champion-panel.astro'
import SimulateModal from '@components/simulate-modal.astro'
import DefaultLayout from '@layouts/default-layout.astro'

type Props = HTMLAttributes<'div'>
const { class: className, ...rest } = Astro.props

// Mutation is displayed as a percentage but stored as a fraction.
const mutationMinPercent = Math.round(MUTATION.minRate * 100)
const mutationMaxPercent = Math.round(MUTATION.maxRate * 100)
const mutationDefaultPercent = Math.round(DEFAULTS.mutationRate * 100)

// Index-based because Infinity is a valid interval choice.
const courseIntervalIndex = COURSE_INTERVALS.indexOf(DEFAULTS.generationsPerCourse)
const courseIntervalLabels = COURSE_INTERVALS.map((interval) =>
    Number.isFinite(interval) ? String(interval) : '∞',
).join(', ')

const brakeBonusIndex = BRAKE_BONUSES.indexOf(DEFAULTS.brakeBonus)
const brakeBonusLabels = BRAKE_BONUSES.join(', ')

const iconSize = 15
---

<script>
    import { createSimulationApp } from '@app'
    let app: { start: () => void; destroy: () => void } | null = null
    const boot = () => {
        const appContainer = document.querySelector('#app-container') as HTMLElement | null
        if (!appContainer) return
        app?.destroy?.()
        app = createSimulationApp(appContainer)
        app.start()
    }
    document.addEventListener('astro:page-load', boot)
    document.addEventListener('astro:before-swap', () => app?.destroy?.())
    window.addEventListener('pagehide', () => app?.destroy?.())
</script>

<DefaultLayout title="Self Driving Car">
    <div class="flex h-full min-h-0 flex-col gap-2 py-2">
        <section
            aria-label="Simulation controls"
            class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs"
        >
            <menu class="flex flex-wrap gap-1.5">
                <Button
                    id={ELEMENT_IDS.buttons.reset}
                    type="button"
                    title="Forget everything evolved so far (the saved network, the veterans archive and the champion) and start from random ones"
                    ><TrashIcon slot="icon" size={iconSize} />Reset</Button
                >
                <Button
                    id={ELEMENT_IDS.buttons.restart}
                    type="button"
                    title="Restart the simulation without saving"
                    ><RedoIcon slot="icon" size={iconSize} />Restart</Button
                >
                <Button
                    id={ELEMENT_IDS.buttons.evolve}
                    type="button"
                    title="Save the active network as winner and restart"
                    ><ChevronsUpIcon slot="icon" size={iconSize} />Evolve</Button
                >
                <Button
                    id={ELEMENT_IDS.buttons.simulate}
                    type="button"
                    class="bg-sky-600 hover:bg-sky-700 focus-visible:outline-sky-400"
                    title="Race in the background without drawing anything, about seventy times faster. Every finished race is listed with its overtakes and its time, and the run ends when a car clears the course"
                    ><FastForwardIcon slot="icon" size={iconSize} />Simulate</Button
                >
            </menu>

            <div class="h-5 w-px bg-current opacity-20" aria-hidden="true"></div>

            <Button
                id={ELEMENT_IDS.buttons.drive}
                type="button"
                role="switch"
                aria-checked="false"
                aria-keyshortcuts="M"
                class="min-w-44"
                title="Start a fresh manual round with M or click. The race waits for your first Arrow/WASD/Space input. The network learns from your driving in real time."
            >
                <span id={ELEMENT_IDS.manualDriveState}>Manual driving: off</span>
                <kbd
                    class="rounded border border-current px-1 text-[10px] leading-4 opacity-80"
                    aria-hidden="true">M</kbd
                >
            </Button
            >

            <Button
                id={ELEMENT_IDS.buttons.traffic}
                type="button"
                role="switch"
                aria-checked="true"
                class="min-w-36 bg-emerald-600 hover:bg-emerald-700"
                title="Show or hide traffic cars without changing the simulation"
            >
                <EyeIcon slot="icon" size={iconSize} aria-hidden="true" />
                <span id={ELEMENT_IDS.trafficState}>Traffic: visible</span>
            </Button>

            <!-- Three radar states require a cycle button rather than a switch. -->
            <Button
                id={ELEMENT_IDS.buttons.radar}
                type="button"
                class="min-w-40 bg-emerald-600 hover:bg-emerald-700"
                title="Cycle the radar between the free-area polygon, the eleven perception zones it summarises, and hidden — without changing sensing or neural-network inputs"
            >
                <EyeIcon slot="icon" size={iconSize} aria-hidden="true" />
                <span id={ELEMENT_IDS.radarState}>Radar: visible</span>
            </Button>

            <Button
                id={ELEMENT_IDS.buttons.sidePanel}
                type="button"
                role="switch"
                aria-checked="false"
                class="min-w-40"
                title="Switch the right-hand pane between the followed car's network and the veterans standings: every network the archive remembers, with its races, its best and worst runs, its median and the time of any course it cleared"
            >
                <TableIcon slot="icon" size={iconSize} aria-hidden="true" />
                <span id={ELEMENT_IDS.sidePanelState}>Panel: network</span>
            </Button>

            <div class="h-5 w-px bg-current opacity-20" aria-hidden="true"></div>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <Field
                    label="Cars"
                    for={ELEMENT_IDS.inputs.carsQuantityRange}
                    title="Population size; a new generation starts when the value changes"
                >
                    <Range
                        id={ELEMENT_IDS.inputs.carsQuantityRange}
                        class="w-24"
                        min={CARS_QUANTITY.min}
                        max={CARS_QUANTITY.max}
                        step={CARS_QUANTITY.step}
                        value={DEFAULTS.carsQuantity}
                    />
                    <NumberInput
                        id={ELEMENT_IDS.inputs.carsQuantityNumber}
                        min={CARS_QUANTITY.min}
                        max={CARS_QUANTITY.max}
                        step={CARS_QUANTITY.step}
                        value={DEFAULTS.carsQuantity}
                        aria-label="Number of cars"
                    />
                </Field>
                <Field
                    label="Mutation %"
                    for={ELEMENT_IDS.inputs.mutationRateRange}
                    title="Base mutation rate in percent, applied to the next generation"
                >
                    <Range
                        id={ELEMENT_IDS.inputs.mutationRateRange}
                        class="w-24"
                        min={mutationMinPercent}
                        max={mutationMaxPercent}
                        step="1"
                        value={mutationDefaultPercent}
                    />
                    <NumberInput
                        id={ELEMENT_IDS.inputs.mutationRateNumber}
                        min={mutationMinPercent}
                        max={mutationMaxPercent}
                        step="1"
                        value={mutationDefaultPercent}
                        aria-label="Mutation rate, percent"
                    />
                </Field>
                <Field
                    label="Layers"
                    for={ELEMENT_IDS.inputs.hiddenLayersInput}
                    title="Hidden layers as comma-separated positive integers, applied on Enter"
                >
                    <Input
                        id={ELEMENT_IDS.inputs.hiddenLayersInput}
                        class="w-20 py-0.5 text-xs"
                        type="text"
                        value={DEFAULTS.hiddenLayers.join(', ')}
                        placeholder="16, 12, 8"
                    />
                </Field>
                <Field
                    label="New traffic every"
                    for={ELEMENT_IDS.inputs.courseIntervalRange}
                    title={`How many generations share one traffic layout, which is the whole course: ${courseIntervalLabels} generations. Fewer means a winner has to re-earn its place against traffic it has never seen; ∞ never re-randomises the traffic, which is the only way to compare scores across a whole run and the fastest way to breed a car that has merely memorised one layout. Applies to the next generation`}
                >
                    <Range
                        id={ELEMENT_IDS.inputs.courseIntervalRange}
                        class="w-20"
                        min="0"
                        max={COURSE_INTERVALS.length - 1}
                        step="1"
                        value={courseIntervalIndex}
                        aria-label="Generations per traffic layout"
                    />
                    <span
                        id={ELEMENT_IDS.courseIntervalValue}
                        class="w-6 text-center tabular-nums"
                        aria-hidden="true">{DEFAULTS.generationsPerCourse}</span
                    >
                </Field>
                <Field
                    label="Brake bonus"
                    for={ELEMENT_IDS.inputs.brakeBonusRange}
                    title={`What one brake press is worth, in overtakes, to a car that also passed somebody: ${brakeBonusLabels}. It is an ignition rather than a reward, paid once per race, to make evolution find a pedal that pays nothing on the first touch. At 10 it outranks a whole typical race, so a braking car can win a round it drove worse; at 0 the ranking is overtakes alone. Applies immediately, to this round too`}
                >
                    <Range
                        id={ELEMENT_IDS.inputs.brakeBonusRange}
                        class="w-20"
                        min="0"
                        max={BRAKE_BONUSES.length - 1}
                        step="1"
                        value={brakeBonusIndex}
                        aria-label="Brake discovery bonus"
                    />
                    <span
                        id={ELEMENT_IDS.brakeBonusValue}
                        class="w-6 text-center tabular-nums"
                        aria-hidden="true">{DEFAULTS.brakeBonus}</span
                    >
                </Field>
            </div>
        </section>

        <section aria-label="Simulation" class="relative min-h-0 grow">
            <div
                id={ELEMENT_IDS.appContainer}
                class:list={[
                    // Give the denser network graph more width than the narrow road.
                    'grid h-full w-full grid-cols-1 grid-rows-2 gap-2 overflow-hidden rounded-md bg-neutral-900 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:grid-rows-1',
                    className,
                ]}
                {...rest}
            >
            </div>
            <InfoPanel
                label="Live stats"
                class="absolute top-2 left-2 max-h-[calc(100%-1rem)] w-44"
            >
                <InfoText
                    id={ELEMENT_IDS.hud.networkId}
                    label="Network"
                    title="Identifier of the followed car's network"
                />
                <InfoText
                    id={ELEMENT_IDS.hud.generation}
                    label="Generation"
                    title="Current generation number"
                />
                <InfoText
                    id={ELEMENT_IDS.hud.aliveCars}
                    label="Alive"
                    title="Cars still racing, out of the total population"
                />
                <InfoText
                    id={ELEMENT_IDS.hud.overtakes}
                    label="Overtakes"
                    title="Traffic cars the followed car has left behind, one point each. This is the whole score"
                />
                <InfoText
                    id={ELEMENT_IDS.hud.raceTime}
                    label="Race time"
                    title="Seconds since this round started, on the same clock the champion's record is measured on"
                />
                <InfoText
                    id={ELEMENT_IDS.hud.idleTimeout}
                    label="Idle timeout"
                    title="Seconds left before the followed car is considered stuck and retired"
                />
                <InfoText
                    id={ELEMENT_IDS.hud.overtakeTimeout}
                    label="Overtake timeout"
                    title="Seconds left to make the next overtake before the car is eliminated and excluded from selection"
                />
                <InfoText
                    id={ELEMENT_IDS.hud.speed}
                    label="Speed"
                    title="Speed of the followed car, in pixels per second"
                />
                <InfoText
                    id={ELEMENT_IDS.hud.headingDeviation}
                    label="Heading"
                    title="Deviation from the road axis in degrees: positive leans right, negative leans left"
                />
                <InfoText id={ELEMENT_IDS.hud.fps} label="FPS" title="Rendered frames per second" />
                <ChampionPanel class="mt-1 border-t border-white/20 pt-1" />
            </InfoPanel>
            <div id={ELEMENT_IDS.statusRegion} class="sr-only" aria-live="polite"></div>
        </section>
        <SimulateModal />
    </div>
</DefaultLayout>
