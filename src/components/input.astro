---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'input'>

const { class: className, ...otherProps } = Astro.props
---

<input
    class:list={[
        'text-stone-800 px-2 py-1 rounded-md font-bold focus-visible:outline-2 focus-visible:outline-rose-400',
        className,
    ]}
    {...otherProps}
/>
