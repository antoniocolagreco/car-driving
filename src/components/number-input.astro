---
import type { HTMLAttributes } from 'astro/types'

/** Typed counterpart to a numeric slider; limits come from core config. */

type Props = HTMLAttributes<'input'>

const { class: className, ...otherProps } = Astro.props
---

<input
    type="number"
    inputmode="numeric"
    class:list={[
        'w-14 rounded-sm px-1 py-0.5 text-right font-semibold tabular-nums text-stone-800 focus-visible:outline-2 focus-visible:outline-rose-400',
        className,
    ]}
    {...otherProps}
/>
