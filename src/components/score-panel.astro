---
import { ELEMENT_IDS } from '@ui/dom'
import type { HTMLAttributes } from 'astro/types'

/**
 * Shows the only reward and the only penalty used by fitness.
 */

type Props = HTMLAttributes<'div'>
const { class: className, ...otherProps } = Astro.props

---

<div class:list={['flex flex-col gap-0.5', className]} {...otherProps}>
    <div class="text-xs uppercase tracking-wide text-white/60 font-semibold">Fitness</div>
    <div class="flex items-baseline justify-between gap-2">
        <span class="text-white/70">Overtakes</span>
        <span
            id={ELEMENT_IDS.hud.breakdown.overtakes}
            class="font-semibold tabular-nums text-green-400"
        >
            –
        </span>
    </div>
    <div class="flex items-baseline justify-between gap-2">
        <span class="text-white/70">Crash / timeout</span>
        <span
            id={ELEMENT_IDS.hud.breakdown.crash}
            class="font-semibold tabular-nums text-red-400"
        >
            –
        </span>
    </div>
</div>
