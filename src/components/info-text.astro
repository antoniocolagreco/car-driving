---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'div'> & {
    label: string
}
const { class: className, title, id, label, ...otherProps } = Astro.props
---

<div title={title} class:list={['flex items-baseline justify-between gap-2', className]} {...otherProps}>
    <span class="text-white/70">{label}</span>
    <span id={id} class="font-semibold tabular-nums">–</span>
</div>
