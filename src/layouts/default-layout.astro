---
import '@css/global.css'
import '@fontsource-variable/inter'
import type { HTMLAttributes } from 'astro/types'

import { ClientRouter } from 'astro:transitions'
import NavLink from '@components/nav-link.astro'

type Props = HTMLAttributes<'html'>

const { lang = 'en', title, ...otherProps } = Astro.props
---

<html lang={lang} {...otherProps}>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Car Driving | {title}</title>
    </head>
    <body
        class="min-h-screen relative bg-stone-50 text-neutral-800 dark:bg-neutral-800 dark:text-stone-50 flex flex-col min-w-0"
    >
        <ClientRouter />
        <header class="bg-rose-600 text-stone-50">
            <nav class="flex w-full items-baseline justify-between gap-4 px-3 py-1">
                <NavLink href={`${import.meta.env.BASE_URL}/`}
                    ><h1 class="text-base font-bold">Car Driving</h1></NavLink
                >
                <NavLink href={`${import.meta.env.BASE_URL}/trigonometry`} class="text-sm"
                    >Trigonometry</NavLink
                >
            </nav>
        </header>
        <main class="w-full min-h-0 grow overflow-hidden px-3" transition:name="main">
            <slot />
        </main>
        <slot name="dialog" />
    </body>
</html>
